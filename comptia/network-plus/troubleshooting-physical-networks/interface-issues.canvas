	"nodes":[
		{"id":"1d713ff62c2f2f6a","x":-520,"y":-280,"width":165,"height":60,"type":"text","text":"Interface Issues"},
		{"id":"6ea7db69bf0fbbe3","x":-300,"y":-440,"width":250,"height":60,"type":"text","text":"Increasing interface counters"},
		{"id":"50b11ab726ef3d7b","x":400,"y":-1130,"width":250,"height":229,"type":"text","text":"A cyclical redundancy error or CRC error is any error\nthat occurs when the check of a data's block integrity\nupon reception doesn't match the check sum value\nthat was attached during the transmission."},
