		{"id":"0ffbc941b5b99103","x":8,"y":-140,"width":250,"height":60,"type":"text","text":"Drops"},
		{"id":"384dfc5224960089","x":400,"y":-157,"width":250,"height":77,"type":"text","text":"occur when buffer is full and cannot accommodate incoming frames or packets"},
		{"id":"98814abf7b5e7934","x":400,"y":-27,"width":250,"height":75,"type":"text","text":"a port on a switch has been automatically shut down"},
		{"id":"29aa385a545a99d2","x":81,"y":210,"width":250,"height":70,"type":"text","text":"an administratively down port status"},
		{"id":"b8532f0ee3836760","x":400,"y":180,"width":250,"height":130,"type":"text","text":"you simply need to issue a specific command  within the network device's interface configuration mode."},
